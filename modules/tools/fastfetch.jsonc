// terminal-hq banner: the system at a glance, in green, when a shell opens
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "color": { "1": "green", "2": "green", "3": "green", "4": "green", "5": "green", "6": "green" } },
  "display": {
    "separator": " ➤ ",
    "color": { "keys": "green", "title": "green" }
  },
  "modules": [
    "title", "separator",
    "os", "host", "kernel", "uptime", "shell", "terminal",
    "cpu", "gpu", "memory", "disk", "localip",
    "break", "colors"
  ]
}
